# Copia a .env (instalar.sh lo hace solo) y llena los valores. NUNCA subir .env a git.

# --- Generados por instalar.sh (no cambiar después) ---
N8N_ENCRYPTION_KEY=
WA_VERIFY_TOKEN=

# --- Meta / WhatsApp Cloud API ---
WA_TOKEN=                # token permanente del usuario del sistema "nodopera-bot"
WA_APP_SECRET=           # App Secret de la app (developers.facebook.com → Configuración → Básica). Sin él, el bot descarta todo.
DEMO_PHONE_ID=1444195448783425   # hoy: número de prueba +1 555 159 1885. Cambiar al del 33 1387 1940 cuando Meta lo apruebe
WA_GRAPH_VERSION=v23.0
DEMO_MONTHLY_LIMIT=950   # el bot se calla al llegar a este número de mensajes en el mes (1,000 gratis)

# --- Avisos por correo (leads del demo) ---
GMAIL_USER=              # tu cuenta de Gmail
GMAIL_APP_PASSWORD=      # contraseña de aplicación de Google (16 letras), NO tu contraseña normal
NOTIFY_FROM=             # normalmente igual a GMAIL_USER
NOTIFY_TO=ulises@nodopera.com
